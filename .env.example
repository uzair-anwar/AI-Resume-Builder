# API keys only — model IDs are chosen in the UI per provider.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — only :free models are allowed in the app
OPENROUTER_API_KEY=

# Google Gemini — free tier; opt in via UI
GEMINI_API_KEY=

# Cloudflare Workers AI — https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Comma-separated provider order for Auto mode (groq,openrouter,gemini,cloudflare)
AI_FALLBACK_ORDER=groq,openrouter,gemini,cloudflare

# Optional orchestration limits (Vercel hobby ~10s; increase on Pro)
AI_MAX_ELAPSED_MS=25000
AI_MAX_ATTEMPTS=6
