# Copy to .env.local and fill in values. Never commit .env.local.

GROQ_API_KEY=gsk_your_key_here
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional: shared passphrase for the access gate (required in production)
ACCESS_PASSPHRASE=choose-a-long-passphrase
AUTH_SECRET=any-long-random-string-at-least-32-chars

# Use mock AI for tests / no-key local runs
# AI_PROVIDER=mock

# Optional comma-separated host allowlist for job URL extraction (e.g. boards.greenhouse.io,jobs.lever.co)
# JOB_HOST_ALLOWLIST=

# E2E only — ignored in production builds
# ALLOW_PRIVATE_FETCH=1
